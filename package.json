{
  "name": "stickytasks",
  "productName": "StickyTasks",
  "version": "1.1.0",
  "description": "Sticky note task list for Windows. Offline-first, themes, reminders.",
  "main": "electron/main.js",
  "author": {
    "name": "Vrunani Muley",
    "url": "https://github.com/vrunani"
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build && electron-builder --publish never"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^39.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.stickytasks.app",
    "productName": "StickyTasks",
    "copyright": "Copyright (c) 2026 Vrunani Muley",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "vrunani",
        "repo": "stickytasks"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "license": "build/license.txt",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "StickyTasks",
      "uninstallDisplayName": "StickyTasks",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  },
  "homepage": "https://github.com/vrunani/stickytasks"
}